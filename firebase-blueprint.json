{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences, her name, mood theme, hug counter, and interaction state",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "herName": {
          "type": "string",
          "maxLength": 50
        },
        "theme": {
          "type": "string",
          "enum": ["blush", "sunset", "lavender", "mint"]
        },
        "hugCount": {
          "type": "integer"
        },
        "petCatCount": {
          "type": "integer"
        },
        "careChecked": {
          "type": "array"
        },
        "ownerId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "herName", "theme", "hugCount", "petCatCount", "ownerId", "updatedAt"]
    },
    "CustomNote": {
      "title": "CustomNote",
      "description": "Heartfelt notes and compliments in the jar",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": ["compliment", "support", "reminder", "smile", "sweet"]
        },
        "authorNote": {
          "type": "string",
          "maxLength": 100
        },
        "userId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "text", "category", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/user_profiles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User personalized settings and interaction states"
    },
    "/user_profiles/{userId}/notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/CustomNote"
      },
      "description": "Personalized heartfelt notes stored in her jar"
    }
  }
}
